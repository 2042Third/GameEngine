#version 460
#extension GL_GOOGLE_include_directive : require

#include "Include/Scene.glsl"
#include "Include/Clusters.glsl"

// Clustered light assignment: one thread per cluster tests the bounding sphere of every visible light against the
// cluster's view-space bounding box and lists the lights that reach it (see Include/Clusters.glsl for the layout).
// Lights are tested in buffer order, which is sorted by relevance: when a cluster is full, the least relevant lights
// are the ones left out. Workgroups stage the light bounds through shared memory.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// View-space bounding spheres (xyz: center, w: radius), parallel to the light buffer.
layout(set = 0, binding = ST_SRV(13), std430) readonly buffer LightBoundsBuffer
{
	vec4 u_LightBounds[];
};
layout(set = 0, binding = ST_UAV(0), std430) writeonly buffer ClusterOutputBuffer
{
	uint o_ClusterLights[];
};

shared vec4 s_LightBounds[64];

// View-space point on the ray through `ndc` at a view depth (distance along the view axis); valid for perspective and
// orthographic projections alike.
vec3 ViewPointAtDepth(vec2 ndc, float viewDepth)
{
	vec4 nearPoint = u_Frame.InverseProjection * vec4(ndc, 1.0, 1.0);
	vec4 farPoint = u_Frame.InverseProjection * vec4(ndc, 0.5, 1.0);
	vec3 origin = nearPoint.xyz / nearPoint.w;
	vec3 direction = farPoint.xyz / farPoint.w - origin;
	float t = (-viewDepth - origin.z) / direction.z;
	return origin + direction * t;
}

bool SphereIntersectsBox(vec4 sphere, vec3 boxMin, vec3 boxMax)
{
	vec3 offset = sphere.xyz - clamp(sphere.xyz, boxMin, boxMax);
	return dot(offset, offset) <= sphere.w * sphere.w;
}

void main()
{
	uvec3 grid = u_Frame.ClusterGrid.xyz;
	uint cluster = gl_GlobalInvocationID.x;
	bool valid = cluster < grid.x * grid.y * grid.z;

	vec3 boxMin = vec3(0.0);
	vec3 boxMax = vec3(0.0);
	if (valid)
	{
		uint x = cluster % grid.x;
		uint y = (cluster / grid.x) % grid.y;
		uint slice = cluster / (grid.x * grid.y);
		// Tile row 0 is at the top of the screen (NDC +Y).
		vec2 ndcMin = vec2(float(x) / float(grid.x) * 2.0 - 1.0, 1.0 - float(y + 1u) / float(grid.y) * 2.0);
		vec2 ndcMax = vec2(float(x + 1u) / float(grid.x) * 2.0 - 1.0, 1.0 - float(y) / float(grid.y) * 2.0);
		float depths[2] = float[](GetClusterSliceStart(slice), GetClusterSliceStart(slice + 1u));

		boxMin = vec3(3.0e38);
		boxMax = vec3(-3.0e38);
		for (int corner = 0; corner < 8; corner++)
		{
			vec2 ndc = vec2((corner & 1) != 0 ? ndcMax.x : ndcMin.x, (corner & 2) != 0 ? ndcMax.y : ndcMin.y);
			vec3 point = ViewPointAtDepth(ndc, depths[corner >> 2]);
			boxMin = min(boxMin, point);
			boxMax = max(boxMax, point);
		}
	}

	uint capacity = u_Frame.ClusterGrid.w;
	uint base = cluster * (capacity + 1u);
	uint count = 0u;
	uint lightCount = u_Frame.LightCounts.x;
	for (uint first = 0u; first < lightCount; first += 64u)
	{
		uint light = first + gl_LocalInvocationIndex;
		s_LightBounds[gl_LocalInvocationIndex] = light < lightCount ? u_LightBounds[light] : vec4(0.0, 0.0, 0.0, -1.0);
		barrier();

		if (valid)
		{
			uint batch = min(64u, lightCount - first);
			for (uint index = 0u; index < batch && count < capacity; index++)
			{
				if (SphereIntersectsBox(s_LightBounds[index], boxMin, boxMax))
				{
					o_ClusterLights[base + 1u + count] = first + index;
					count++;
				}
			}
		}
		barrier();
	}

	if (valid)
		o_ClusterLights[base] = count;
}
