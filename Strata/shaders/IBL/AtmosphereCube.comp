#version 460
#extension GL_GOOGLE_include_directive : require

#include "Include/AtmospherePass.glsl"
#include "Include/IBL.glsl"

// Level 0 of an atmosphere's environment cube from the sky-view table, a face per layer of the dispatch from
// u_Pass.FirstFace on (one face per frame while it refreshes, or all six at once). The sun's disk is not in it: the
// background draws it, and the directional light lights the scene with it.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = ST_UAV(0), rgba16f) uniform writeonly image2DArray o_Cube;

void main()
{
	uvec3 id = gl_GlobalInvocationID;
	uint size = u_Pass.FaceSize;
	if (id.x >= size || id.y >= size)
		return;
	uint face = u_Pass.FirstFace + id.z;
	vec3 direction = CubeTexelDirection(id.xy, face, size);
	vec3 color = textureLod(sampler2D(u_SkyViewTable, u_TableSampler), DirectionToSkyViewUV(direction), 0.0).rgb;
	imageStore(o_Cube, ivec3(id.xy, face), vec4(clamp(color, vec3(0.0), vec3(65000.0)), 1.0));
}
