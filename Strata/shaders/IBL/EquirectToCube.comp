#version 460
#extension GL_GOOGLE_include_directive : require

#include "Include/IBL.glsl"

// Resamples an equirectangular environment map into mip 0 of a cubemap.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = ST_SRV(0)) uniform texture2D u_Source;
layout(set = 0, binding = ST_SAMPLER(0)) uniform sampler u_Sampler;
layout(set = 0, binding = ST_UAV(0), rgba16f) uniform writeonly image2DArray o_Output;

layout(push_constant) uniform Parameters
{
	uint OutputSize;
	uint SourceSize;
	float Roughness;
	uint SampleCount;
} u_Parameters;

void main()
{
	uvec3 id = gl_GlobalInvocationID;
	if (id.x >= u_Parameters.OutputSize || id.y >= u_Parameters.OutputSize)
		return;
	vec3 direction = CubeTexelDirection(id.xy, id.z, u_Parameters.OutputSize);
	// A face spans a quarter of the equirect's width: pick the source mip whose texel density matches the face.
	float lod = max(0.0, log2(float(u_Parameters.SourceSize) / (4.0 * float(u_Parameters.OutputSize))));
	vec3 color = textureLod(sampler2D(u_Source, u_Sampler), DirectionToEquirect(direction), lod).rgb;
	// Keep the result finite and within half-float range (sun disks in HDRIs can exceed it).
	color = clamp(color, vec3(0.0), vec3(65000.0));
	imageStore(o_Output, ivec3(id), vec4(color, 1.0));
}
