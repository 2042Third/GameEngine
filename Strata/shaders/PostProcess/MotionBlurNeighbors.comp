#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

#include "Include/MotionBlur.glsl"

// The motion blur's neighbor maxima: per tile, the largest tile maximum of its 3x3 neighborhood, so a pixel's gather reaches as
// far as anything that can blur over it. A diagonal neighbor counts only when its blur runs toward the center tile (within 45
// degrees of the diagonal, either way: the blur spreads both ways along it); the edge neighbors always reach.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = ST_SRV(2)) uniform texture2D u_TileMax;
layout(set = 0, binding = ST_UAV(0), rgba16f) uniform writeonly image2D o_NeighborMax;

void main()
{
	ivec2 tile = ivec2(gl_GlobalInvocationID.xy);
	ivec2 depthSize = ivec2(u_Frame.ViewportSize.xy);
	int tileSize = int(u_MotionBlur.TileSize);
	ivec2 tiles = (depthSize + tileSize - 1) / tileSize;
	if (any(greaterThanEqual(tile, tiles)))
		return;
	vec2 largest = vec2(0.0);
	for (int y = -1; y <= 1; y++)
	{
		for (int x = -1; x <= 1; x++)
		{
			ivec2 neighbor = tile + ivec2(x, y);
			if (any(lessThan(neighbor, ivec2(0))) || any(greaterThanEqual(neighbor, tiles)))
				continue;
			vec2 velocity = texelFetch(u_TileMax, neighbor, 0).xy;
			float speed = length(velocity);
			if (x != 0 && y != 0 && speed > 0.0 && abs(dot(velocity / speed, vec2(x, y) * 0.70710678)) < 0.70710678)
				continue;
			if (dot(velocity, velocity) > dot(largest, largest))
				largest = velocity;
		}
	}
	imageStore(o_NeighborMax, tile, vec4(largest, 0.0, 0.0));
}
