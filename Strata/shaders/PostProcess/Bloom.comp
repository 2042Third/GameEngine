#version 460
#extension GL_GOOGLE_include_directive : require

#include "Include/Common.glsl"
#include "Include/Exposure.glsl"

// Bloom (Jimenez, "Next Generation Post Processing in Call of Duty: Advanced Warfare"): the exposed scene color
// is downsampled through a mip chain with a 13-tap filter, then each level is upsampled with a 3x3 tent filter and
// added to the next larger one. The first downsample also applies the threshold and weights its samples by
// inverse luminance (Karis average), which keeps single bright pixels from flickering.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = ST_SRV(0)) uniform texture2D u_Source;
layout(set = 0, binding = ST_SAMPLER(0)) uniform sampler u_LinearClamp;
layout(set = 0, binding = ST_UAV(0), rgba16f) uniform image2D o_Destination;
layout(set = 0, binding = ST_SRV(1), std430) readonly buffer ExposureBuffer
{
	float u_Exposure[];
};

#define ST_BLOOM_PREFILTER  0u
#define ST_BLOOM_DOWNSAMPLE 1u
#define ST_BLOOM_UPSAMPLE   2u

layout(push_constant) uniform BloomParameters
{
	float Threshold; // On the exposed color; 0 lets every pixel scatter
	float Knee;      // Width of the soft transition around the threshold
	uint Mode;
	float Padding;
} u_Parameters;

vec3 SampleSource(vec2 uv)
{
	return textureLod(sampler2D(u_Source, u_LinearClamp), uv, 0.0).rgb;
}

float KarisWeight(vec3 color, float weight)
{
	return weight / (1.0 + Luminance(color));
}

vec3 Downsample(vec2 uv, vec2 texel, bool karisAverage)
{
	// a . b . c
	// . j . k .
	// d . e . f
	// . l . m .
	// g . h . i
	vec3 a = SampleSource(uv + texel * vec2(-2.0, -2.0));
	vec3 b = SampleSource(uv + texel * vec2(0.0, -2.0));
	vec3 c = SampleSource(uv + texel * vec2(2.0, -2.0));
	vec3 d = SampleSource(uv + texel * vec2(-2.0, 0.0));
	vec3 e = SampleSource(uv);
	vec3 f = SampleSource(uv + texel * vec2(2.0, 0.0));
	vec3 g = SampleSource(uv + texel * vec2(-2.0, 2.0));
	vec3 h = SampleSource(uv + texel * vec2(0.0, 2.0));
	vec3 i = SampleSource(uv + texel * vec2(2.0, 2.0));
	vec3 j = SampleSource(uv + texel * vec2(-1.0, -1.0));
	vec3 k = SampleSource(uv + texel * vec2(1.0, -1.0));
	vec3 l = SampleSource(uv + texel * vec2(-1.0, 1.0));
	vec3 m = SampleSource(uv + texel * vec2(1.0, 1.0));

	// Five overlapping 2x2 boxes: the center one weighs 0.5, the corner ones 0.125 each.
	vec3 boxes[5] = vec3[](
		(j + k + l + m) * 0.25,
		(a + b + d + e) * 0.25,
		(b + c + e + f) * 0.25,
		(d + e + g + h) * 0.25,
		(e + f + h + i) * 0.25);
	float weights[5] = float[](0.5, 0.125, 0.125, 0.125, 0.125);

	vec3 result = vec3(0.0);
	float weightSum = 0.0;
	for (int box = 0; box < 5; box++)
	{
		float weight = karisAverage ? KarisWeight(boxes[box], weights[box]) : weights[box];
		result += boxes[box] * weight;
		weightSum += weight;
	}
	return result / weightSum;
}

vec3 Upsample(vec2 uv, vec2 texel)
{
	// 3x3 tent filter: 1 2 1 / 2 4 2 / 1 2 1
	vec3 result = SampleSource(uv) * 4.0;
	result += (SampleSource(uv + vec2(0.0, -texel.y)) + SampleSource(uv + vec2(-texel.x, 0.0))
		+ SampleSource(uv + vec2(texel.x, 0.0)) + SampleSource(uv + vec2(0.0, texel.y))) * 2.0;
	result += SampleSource(uv + vec2(-texel.x, -texel.y)) + SampleSource(uv + vec2(texel.x, -texel.y))
		+ SampleSource(uv + vec2(-texel.x, texel.y)) + SampleSource(uv + vec2(texel.x, texel.y));
	return result / 16.0;
}

vec3 ApplyThreshold(vec3 color)
{
	if (u_Parameters.Threshold <= 0.0)
		return color;
	// Soft knee: a quadratic ramp around the threshold instead of a hard cut.
	float brightness = max(color.r, max(color.g, color.b));
	float knee = max(u_Parameters.Knee, 1e-5);
	float soft = clamp(brightness - u_Parameters.Threshold + knee, 0.0, 2.0 * knee);
	soft = soft * soft / (4.0 * knee);
	return color * (max(soft, brightness - u_Parameters.Threshold) / max(brightness, 1e-5));
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(o_Destination);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	vec2 texel = 1.0 / vec2(textureSize(sampler2D(u_Source, u_LinearClamp), 0));
	vec3 color;
	if (u_Parameters.Mode == ST_BLOOM_UPSAMPLE)
	{
		color = imageLoad(o_Destination, pixel).rgb + Upsample(uv, texel);
	}
	else if (u_Parameters.Mode == ST_BLOOM_PREFILTER)
	{
		color = ApplyThreshold(Downsample(uv, texel, true) * u_Exposure[ST_EXPOSURE_MULTIPLIER]);
		// Non-finite scene colors (a broken material) must not spread over the whole screen.
		if (any(isnan(color)) || any(isinf(color)))
			color = vec3(0.0);
		color = min(color, vec3(65000.0));
	}
	else
	{
		color = Downsample(uv, texel, false);
	}
	imageStore(o_Destination, pixel, vec4(color, 1.0));
}
