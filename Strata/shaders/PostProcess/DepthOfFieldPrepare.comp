#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

#include "Include/DepthOfField.glsl"

// Depth of field's half-resolution image: each texel the mean color of its 2x2 full-resolution pixels and, in alpha, a signed
// circle of confusion in half-resolution pixels: the nearest pixel's when one lies in the near field (a near silhouette keeps
// its blur), else the farthest's.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = ST_SRV(0)) uniform texture2D u_Color;
layout(set = 0, binding = ST_SRV(1)) uniform texture2D u_Depth;
layout(set = 0, binding = ST_UAV(0), rgba16f) uniform writeonly image2D o_Half;

void main()
{
	ivec2 size = textureSize(u_Color, 0);
	ivec2 halfSize = (size + 1) / 2;
	ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(texel, halfSize)))
		return;
	vec3 color = vec3(0.0);
	float nearest = 1e30;
	float farthest = -1e30;
	for (int index = 0; index < 4; index++)
	{
		ivec2 pixel = min(2 * texel + ivec2(index & 1, index >> 1), size - 1);
		color += texelFetch(u_Color, pixel, 0).rgb;
		float coc = GetCircleOfConfusion((vec2(pixel) + 0.5) * u_Frame.ViewportSize.zw, texelFetch(u_Depth, pixel, 0).r);
		nearest = min(nearest, coc);
		farthest = max(farthest, coc);
	}
	float coc = nearest < -2.0 * c_DepthOfFieldInFocus ? nearest : farthest;
	imageStore(o_Half, texel, vec4(color * 0.25, 0.5 * coc));
}
