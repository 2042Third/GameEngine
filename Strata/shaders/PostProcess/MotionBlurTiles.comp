#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

#include "Include/MotionBlur.glsl"

// The motion blur's tile maxima: one group per tile of TileSize pixels; its threads scan the tile's pixels in turn. The blur
// velocity (GetBlurVelocity) of the largest length goes to the tile's texel (xy) with the diagonal of the box that holds all
// of the tile's blur velocities (z: how far they spread). Every pixel's blur radius and view distance go to the pixel target,
// which the gather reads for its samples (one fetch where velocity and depth would take two, and none of their math).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = ST_SRV(0)) uniform texture2D u_Velocity;
layout(set = 0, binding = ST_SRV(1)) uniform texture2D u_Depth;
layout(set = 0, binding = ST_UAV(0), rgba16f) uniform writeonly image2D o_TileMax;
layout(set = 0, binding = ST_UAV(1), r32ui) uniform writeonly uimage2D o_Pixels;

shared vec2 s_Largest[64];
shared vec4 s_Bounds[64]; // xy the smallest, zw the largest blur velocity's components

void main()
{
	ivec2 size = textureSize(u_Depth, 0);
	ivec2 tile = ivec2(gl_WorkGroupID.xy);
	int tileSize = int(u_MotionBlur.TileSize);
	ivec2 origin = tile * tileSize;
	vec2 largest = vec2(0.0);
	vec4 bounds = vec4(1e30, 1e30, -1e30, -1e30);
	for (int y = int(gl_LocalInvocationID.y); y < tileSize; y += 8)
	{
		for (int x = int(gl_LocalInvocationID.x); x < tileSize; x += 8)
		{
			ivec2 pixel = origin + ivec2(x, y);
			if (any(greaterThanEqual(pixel, size)))
				continue;
			vec2 uv = (vec2(pixel) + 0.5) * u_Frame.ViewportSize.zw;
			float depth = texelFetch(u_Depth, pixel, 0).r;
			vec2 velocity = GetBlurVelocity(texelFetch(u_Velocity, pixel, 0).rg, depth, uv);
			imageStore(o_Pixels, pixel, uvec4(PackBlurPixel(GetBlurRadius(velocity), GetViewDistance(uv, depth)), 0u, 0u, 0u));
			if (dot(velocity, velocity) > dot(largest, largest))
				largest = velocity;
			bounds = vec4(min(bounds.xy, velocity), max(bounds.zw, velocity));
		}
	}
	s_Largest[gl_LocalInvocationIndex] = largest;
	s_Bounds[gl_LocalInvocationIndex] = bounds;
	barrier();
	for (uint stride = 32u; stride > 0u; stride >>= 1u)
	{
		if (gl_LocalInvocationIndex < stride)
		{
			vec2 other = s_Largest[gl_LocalInvocationIndex + stride];
			if (dot(other, other) > dot(s_Largest[gl_LocalInvocationIndex], s_Largest[gl_LocalInvocationIndex]))
				s_Largest[gl_LocalInvocationIndex] = other;
			vec4 otherBounds = s_Bounds[gl_LocalInvocationIndex + stride];
			vec4 ownBounds = s_Bounds[gl_LocalInvocationIndex];
			s_Bounds[gl_LocalInvocationIndex] = vec4(min(ownBounds.xy, otherBounds.xy), max(ownBounds.zw, otherBounds.zw));
		}
		barrier();
	}
	if (gl_LocalInvocationIndex == 0u)
	{
		// A tile always holds a pixel (the grid covers the image and no more), so its bounds are set.
		vec4 tileBounds = s_Bounds[0];
		imageStore(o_TileMax, tile, vec4(s_Largest[0], length(tileBounds.zw - tileBounds.xy), 0.0));
	}
}
