#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

#include "Include/ShadowView.glsl"

// The shadows debug view's statistics (SceneRenderer::GetShadowViewStats): every pixel of the frame counted as sky, as a
// surface no cascade covers, or in its cascade's bin of screen pixels per shadow texel (Include/ShadowView.glsl, the same
// pixels Overlay/ShadowView.frag colors). Each group counts in shared memory and adds its non-zero counts to the buffer
// (RenderData::ShadowViewCounts, cleared before the dispatch) with one atomic add each.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = ST_SRV(22)) uniform texture2D u_Depth;

layout(set = 0, binding = ST_UAV(0), std430) buffer ShadowViewCountBuffer
{
	uint Bins[4 * 64]; // RenderData::c_MaxCascades rows of RenderData::c_ShadowViewBins
	uint SurfacePixels;
	uint SkyPixels;
	uint UncoveredPixels;
	uint Reserved;
} o_Counts;

shared uint s_Bins[4 * 64]; // One entry per thread of the group
shared uint s_Surface;
shared uint s_Sky;
shared uint s_Uncovered;

void main()
{
	uint thread = gl_LocalInvocationIndex;
	s_Bins[thread] = 0u;
	if (thread == 0u)
	{
		s_Surface = 0u;
		s_Sky = 0u;
		s_Uncovered = 0u;
	}
	barrier();

	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (all(lessThan(pixel, ivec2(u_Frame.ViewportSize.xy))))
	{
		float depth = texelFetch(u_Depth, pixel, 0).r;
		ShadowViewSample viewSample;
		if (!(depth > 0.0))
			atomicAdd(s_Sky, 1u);
		else
		{
			atomicAdd(s_Surface, 1u);
			if (GetShadowViewSample(pixel, depth, viewSample))
				atomicAdd(s_Bins[viewSample.Cascade * 64 + GetShadowViewBin(viewSample.PixelsPerTexel)], 1u);
			else
				atomicAdd(s_Uncovered, 1u);
		}
	}
	barrier();

	if (s_Bins[thread] != 0u)
		atomicAdd(o_Counts.Bins[thread], s_Bins[thread]);
	if (thread == 0u)
	{
		if (s_Surface != 0u)
			atomicAdd(o_Counts.SurfacePixels, s_Surface);
		if (s_Sky != 0u)
			atomicAdd(o_Counts.SkyPixels, s_Sky);
		if (s_Uncovered != 0u)
			atomicAdd(o_Counts.UncoveredPixels, s_Uncovered);
	}
}
