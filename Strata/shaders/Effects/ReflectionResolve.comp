#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

#include "Include/Scene.glsl"

// The spatial resolve of screen-space reflections at Spatial and SpatialHigh (SceneRenderer::TraceSpatialReflections, after
// Effects/ScreenSpaceReflectionsSpatial.comp, in GPU.Reflections), which needs no history: per pixel, the 3x3 neighborhood's
// traced reflections (premultiplied by their confidence) averaged as a ratio estimator. A neighbor's ray left along its own
// mirror direction L; the weight of what it found is the center's GGX lobe D toward L (the half vector of the center's view
// and L) over the density the neighbor's ray stands for (its own lobe's peak, 1 / (pi alpha^2)), at most the center's own
// weight 1, times depth and normal weights as ambient occlusion's denoiser has them. A smooth center keeps its own sharp
// reflection (its lobe is far narrower than the neighbors' differences); a rough one borrows its neighbors' rays, which hides
// the march's fixed 4x4 offsets. One dispatch of 8x8 groups, each loading the 10x10 pixels around its own. Writes the texture
// the forward pass reads at SRV 18 (rgb times the confidence, a the confidence); background pixels write 0.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = ST_SRV(22)) uniform texture2D u_Depth;
layout(set = 0, binding = ST_SRV(23)) uniform texture2D u_Surface; // xy: octahedral view-space normal (normal-mapped), z: roughness
layout(set = 0, binding = ST_SRV(25)) uniform texture2D u_Traced;
layout(set = 0, binding = ST_UAV(0), rgba16f) uniform writeonly image2D o_Reflections;

const int c_Group = 8;
const int c_Tile = c_Group + 2;
const float c_DepthSharpness = 50.0; // exp(-50 x relative depth difference), as AODenoise.comp's
const float c_NormalPower = 8.0;
const float c_MinRoughness = 0.045;  // PBR.glsl's lower bound of the perceptual roughness

shared vec4 s_Traced[c_Tile * c_Tile];
shared vec4 s_NormalAlpha[c_Tile * c_Tile]; // xyz: the view-space normal, w: alpha^2 (0 for the background)
shared vec4 s_DirectionDepth[c_Tile * c_Tile]; // xyz: the view-space mirror direction, w: the linear depth

void main()
{
	ivec2 size = ivec2(u_Frame.ViewportSize.xy);
	ivec2 tileOrigin = ivec2(gl_WorkGroupID.xy) * c_Group - 1;
	bool orthographic = u_Frame.CameraForward.w > 0.5;
	for (uint index = gl_LocalInvocationIndex; index < uint(c_Tile * c_Tile); index += uint(c_Group * c_Group))
	{
		ivec2 pixel = clamp(tileOrigin + ivec2(int(index) % c_Tile, int(index) / c_Tile), ivec2(0), size - 1);
		float depth = texelFetch(u_Depth, pixel, 0).r;
		s_Traced[index] = texelFetch(u_Traced, pixel, 0);
		if (depth <= 0.0)
		{
			s_NormalAlpha[index] = vec4(0.0);
			s_DirectionDepth[index] = vec4(0.0);
			continue;
		}
		vec4 surface = texelFetch(u_Surface, pixel, 0);
		vec3 normal = OctahedralDecode(surface.xy);
		float roughness = max(surface.z, c_MinRoughness);
		float alpha = roughness * roughness;
		vec2 uv = (vec2(pixel) + 0.5) * u_Frame.ViewportSize.zw;
		vec4 viewPoint = u_Frame.InverseProjection * vec4(UVToNDC(uv), depth, 1.0);
		vec3 position = viewPoint.xyz / viewPoint.w;
		vec3 incident = orthographic ? vec3(0.0, 0.0, -1.0) : normalize(position);
		s_NormalAlpha[index] = vec4(normal, alpha * alpha);
		s_DirectionDepth[index] = vec4(reflect(incident, normal), -position.z);
	}
	barrier();

	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;
	ivec2 center = ivec2(gl_LocalInvocationID.xy) + 1;
	int centerIndex = center.y * c_Tile + center.x;
	vec4 centerNormalAlpha = s_NormalAlpha[centerIndex];
	if (centerNormalAlpha.w <= 0.0)
	{
		imageStore(o_Reflections, pixel, vec4(0.0));
		return;
	}
	vec3 centerNormal = centerNormalAlpha.xyz;
	float centerAlpha2 = centerNormalAlpha.w;
	float centerDepth = s_DirectionDepth[centerIndex].w;
	// The center's direction toward the camera: its mirror direction reflected back about its normal is the incident one.
	vec3 view = -reflect(s_DirectionDepth[centerIndex].xyz, centerNormal);
	vec4 sum = s_Traced[centerIndex];
	float weightSum = 1.0;
	for (int y = -1; y <= 1; y++)
	{
		for (int x = -1; x <= 1; x++)
		{
			if (x == 0 && y == 0)
				continue;
			int sampleIndex = (center.y + y) * c_Tile + center.x + x;
			vec4 normalAlpha = s_NormalAlpha[sampleIndex];
			if (normalAlpha.w <= 0.0)
				continue;
			vec4 directionDepth = s_DirectionDepth[sampleIndex];
			float depthWeight = exp(-c_DepthSharpness * abs(directionDepth.w - centerDepth) / centerDepth);
			float normalWeight = pow(max(dot(normalAlpha.xyz, centerNormal), 0.0), c_NormalPower);
			vec3 halfVector = normalize(view + directionDepth.xyz);
			float nDotH = max(dot(centerNormal, halfVector), 0.0);
			float denominator = nDotH * nDotH * (centerAlpha2 - 1.0) + 1.0;
			// pi alpha_i^2 x D_center(H), with D = alpha_c^2 / (pi denominator^2): the pis cancel.
			float lobeWeight = min(normalAlpha.w * centerAlpha2 / max(denominator * denominator, 1e-12), 1.0);
			float weight = lobeWeight * depthWeight * normalWeight;
			sum += s_Traced[sampleIndex] * weight;
			weightSum += weight;
		}
	}
	imageStore(o_Reflections, pixel, sum / weightSum);
}
