#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

#include "Include/Scene.glsl"

// Ambient occlusion's denoiser, which needs no history: GTAO.comp turns its slices by a fixed 4x4 pattern of 16 rotations
// (never by the frame), so every 4x4 block of pixels holds all of them. Per pixel this pass first resolves the pattern, a
// 5x5 bilateral average whose tent weights (0.5, 1, 1, 1, 0.5) in x and y weigh each of the 16 phases exactly once while the
// kernel stays centered, kept to the pixel's surface by depth and normal weights; then it blurs the resolved occlusion over
// 5x5 pixels within depth edges (Strata 0.6.0's AOBlur). One dispatch of 8x8 groups: each loads the 16x16 tile around its
// pixels (raw occlusion, linear depth and normal) into group-shared memory, resolves the 12x12 pixels its blur reads, and
// writes its 8x8. Background pixels (depth 0) write 1 and weigh nothing. With ST_AO_HALF (registered as
// Effects/AODenoiseHalf.comp) it writes a half-precision target.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = ST_SRV(8)) uniform texture2D u_Depth;
layout(set = 0, binding = ST_SRV(9)) uniform texture2D u_Normals;
layout(set = 0, binding = ST_SRV(10)) uniform texture2D u_Input;
#ifdef ST_AO_HALF
layout(set = 0, binding = ST_UAV(0), r16f) uniform writeonly image2D o_Output;
#else
layout(set = 0, binding = ST_UAV(0), r32f) uniform writeonly image2D o_Output;
#endif

const int c_Group = 8;
const int c_TileBorder = 4;                       // The resolve's 2 pixels plus the blur's 2
const int c_Tile = c_Group + 2 * c_TileBorder;    // 16
const int c_Resolved = c_Group + 4;               // 12: the group's pixels and the blur's 2 around them
const float c_DepthSharpness = 50.0;              // exp(-50 x relative depth difference), as the 0.6.0 blur
const float c_NormalPower = 8.0;

shared float s_Occlusion[c_Tile * c_Tile];
shared float s_Depth[c_Tile * c_Tile];            // Linear view depth; 0 for the background
shared vec3 s_Normal[c_Tile * c_Tile];
shared float s_Resolved[c_Resolved * c_Resolved];

float LinearDepth(float depth)
{
	// Distance along the view axis; with reversed-Z, depth falls toward 0 with distance.
	vec4 view = u_Frame.InverseProjection * vec4(0.0, 0.0, depth, 1.0);
	return -view.z / view.w;
}

float TentWeight(int offset)
{
	return abs(offset) == 2 ? 0.5 : 1.0;
}

void main()
{
	ivec2 size = ivec2(u_Frame.ViewportSize.xy);
	ivec2 groupOrigin = ivec2(gl_WorkGroupID.xy) * c_Group;
	ivec2 tileOrigin = groupOrigin - c_TileBorder;
	uint thread = gl_LocalInvocationIndex;

	// The tile, clamped to the image (edge pixels repeat, as the 0.6.0 blur's samples did).
	for (uint index = thread; index < uint(c_Tile * c_Tile); index += uint(c_Group * c_Group))
	{
		ivec2 pixel = clamp(tileOrigin + ivec2(int(index) % c_Tile, int(index) / c_Tile), ivec2(0), size - 1);
		float depth = texelFetch(u_Depth, pixel, 0).r;
		s_Occlusion[index] = texelFetch(u_Input, pixel, 0).r;
		s_Depth[index] = depth > 0.0 ? LinearDepth(depth) : 0.0;
		s_Normal[index] = depth > 0.0 ? OctahedralDecode(texelFetch(u_Normals, pixel, 0).rg) : vec3(0.0);
	}
	barrier();

	// The pattern's resolve for the 12x12 pixels around the group's (tile coordinates 2 to 13).
	for (uint index = thread; index < uint(c_Resolved * c_Resolved); index += uint(c_Group * c_Group))
	{
		ivec2 center = ivec2(int(index) % c_Resolved, int(index) / c_Resolved) + 2;
		int centerIndex = center.y * c_Tile + center.x;
		float centerDepth = s_Depth[centerIndex];
		float resolved = 1.0;
		if (centerDepth > 0.0)
		{
			vec3 centerNormal = s_Normal[centerIndex];
			float sum = 0.0;
			float weightSum = 0.0;
			for (int y = -2; y <= 2; y++)
			{
				for (int x = -2; x <= 2; x++)
				{
					int sampleIndex = (center.y + y) * c_Tile + center.x + x;
					float sampleDepth = s_Depth[sampleIndex];
					if (sampleDepth <= 0.0)
						continue;
					float depthWeight = exp(-c_DepthSharpness * abs(sampleDepth - centerDepth) / centerDepth);
					float normalWeight = pow(max(dot(s_Normal[sampleIndex], centerNormal), 0.0), c_NormalPower);
					float weight = TentWeight(x) * TentWeight(y) * depthWeight * normalWeight;
					sum += s_Occlusion[sampleIndex] * weight;
					weightSum += weight;
				}
			}
			resolved = weightSum > 0.0 ? sum / weightSum : s_Occlusion[centerIndex];
		}
		s_Resolved[index] = resolved;
	}
	barrier();

	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;
	ivec2 local = ivec2(gl_LocalInvocationID.xy);
	float centerDepth = s_Depth[(local.y + c_TileBorder) * c_Tile + local.x + c_TileBorder];
	if (centerDepth <= 0.0)
	{
		imageStore(o_Output, pixel, vec4(1.0));
		return;
	}
	// The 0.6.0 blur over the resolved occlusion: 5x5, weighted by depth.
	float sum = 0.0;
	float weightSum = 0.0;
	for (int y = -2; y <= 2; y++)
	{
		for (int x = -2; x <= 2; x++)
		{
			ivec2 resolvedPixel = local + 2 + ivec2(x, y);
			float sampleDepth = s_Depth[(resolvedPixel.y + 2) * c_Tile + resolvedPixel.x + 2];
			if (sampleDepth <= 0.0)
				continue;
			float weight = exp(-c_DepthSharpness * abs(sampleDepth - centerDepth) / centerDepth);
			sum += s_Resolved[resolvedPixel.y * c_Resolved + resolvedPixel.x] * weight;
			weightSum += weight;
		}
	}
	imageStore(o_Output, pixel, vec4(weightSum > 0.0 ? sum / weightSum : 1.0));
}
