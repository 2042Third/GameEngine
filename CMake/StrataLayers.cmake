# The engine's libraries, made from its layer table (StrataTests/Architecture/Layers.json): one static library per layer,
# linking exactly the layers the table lets it include, so that the table Architecture.Layering checks is the build.
#
# strata_add_layer_libraries(TABLE <Layers.json> SOURCE_ROOT <dir> LIBRARIES_FILE <file>)
#   Globs every engine source under SOURCE_ROOT once (.h .hpp .inl .c .cpp .m .mm, the files LayeringAnalyzer reads; other
#   operating systems' Platform/<OS>/ folders left out) and gives each file to the one layer whose Paths match it and whose
#   Exclude does not (globs relative to SOURCE_ROOT: '**/' is any directories or none, '**' anything, '*' and '?' stay
#   within one path component). A file in no layer or in two fails the configure, naming it.
#   For every layer whose option is on (a layer's "Option" names the CMake option that builds it), it makes
#   Strata_<Layer> (ALIAS Strata::<Layer>): STATIC with strata_configure_target, the precompiled header stpch.h (each
#   library its own: vendor definitions differ between layers, so one cannot reuse another's) and the
#   code generation every engine object shares (StrataEngineCodegen, PRIVATE), or INTERFACE when the layer has nothing to
#   compile. It links PUBLIC the built layers of its MayInclude. Layers marked "Tooling" (no game contains them) are
#   EXCLUDE_FROM_ALL.
#   Sets STRATA_BUILT_LAYERS, STRATA_RUNTIME_LAYERS (built, not tooling) and STRATA_TOOLING_LAYERS (built, tooling) in the
#   caller's scope, and writes LIBRARIES_FILE: every layer's target, whether it is built, its sources and the layers it
#   links (read by Architecture.Libraries).
#
# strata_layer_link(<Layer> <PUBLIC|PRIVATE|INTERFACE> <item>...)
#   Links vendor and system libraries to a layer's library when the layer is built (the table of Strata/CMakeLists.txt).
#
# strata_check_link_closure(<target> FORBID <name>...)
#   Fails the configure when what <target> links, directly or through any library it links, holds one of the named
#   targets or a tooling layer's library: the proof that games link no tooling. The check runs at the end of the top-level
#   directory (cmake_language(DEFER)), once every directory has defined its targets and links: a name that is not a target
#   yet would otherwise be skipped, whatever it links.

# Calls `command` with these arguments at the end of the top-level directory, once every directory has defined its targets
# and links. cmake_language(DEFER CALL) expands variable references only when the call runs, in that directory's scope, so
# the values are written into the call here.
function(strata_defer_to_end command)
	set(arguments "")
	foreach(argument IN LISTS ARGN)
		string(APPEND arguments " [==[${argument}]==]")
	endforeach()
	cmake_language(EVAL CODE "cmake_language(DEFER DIRECTORY [==[${PROJECT_SOURCE_DIR}]==] CALL ${command}${arguments})")
endfunction()

# A glob of Layers.json as an anchored CMake regular expression, with LayeringAnalyzer's MatchesGlob semantics.
function(strata_glob_to_regex glob outVariable)
	set(regex "${glob}")
	string(REPLACE "**/" "@STRATA_DIRS@" regex "${regex}")
	string(REPLACE "**" "@STRATA_ANY@" regex "${regex}")
	foreach(character IN ITEMS "\\" "." "+" "^" "$" "(" ")" "[" "]" "{" "}" "|")
		string(REPLACE "${character}" "\\${character}" regex "${regex}")
	endforeach()
	string(REPLACE "*" "[^/]*" regex "${regex}")
	string(REPLACE "?" "[^/]" regex "${regex}")
	string(REPLACE "@STRATA_DIRS@" "(.*/)?" regex "${regex}")
	string(REPLACE "@STRATA_ANY@" ".*" regex "${regex}")
	set(${outVariable} "^${regex}$" PARENT_SCOPE)
endfunction()

# Reads the array <member> of the JSON object `json` into a CMake list (empty when the member is absent).
function(strata_json_string_array json member outVariable)
	set(values "")
	string(JSON type ERROR_VARIABLE error TYPE "${json}" ${member})
	if(NOT error AND type STREQUAL "ARRAY")
		string(JSON count LENGTH "${json}" ${member})
		if(count GREATER 0)
			math(EXPR last "${count} - 1")
			foreach(index RANGE ${last})
				string(JSON value GET "${json}" ${member} ${index})
				list(APPEND values "${value}")
			endforeach()
		endif()
	endif()
	set(${outVariable} "${values}" PARENT_SCOPE)
endfunction()

# A JSON string literal of `value` (paths and names: quotes and backslashes escaped).
function(strata_json_quote value outVariable)
	string(REPLACE "\\" "\\\\" value "${value}")
	string(REPLACE "\"" "\\\"" value "${value}")
	set(${outVariable} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(strata_add_layer_libraries)
	cmake_parse_arguments(ARG "" "TABLE;SOURCE_ROOT;LIBRARIES_FILE" "" ${ARGN})
	foreach(argument TABLE SOURCE_ROOT LIBRARIES_FILE)
		if(NOT ARG_${argument})
			message(FATAL_ERROR "strata_add_layer_libraries: ${argument} is required")
		endif()
	endforeach()
	if(NOT TARGET StrataEngineCodegen)
		message(FATAL_ERROR "strata_add_layer_libraries: define StrataEngineCodegen first")
	endif()

	# The table is part of the build: an edit reconfigures.
	set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ARG_TABLE}")
	file(READ "${ARG_TABLE}" table)
	string(JSON layerCount ERROR_VARIABLE error LENGTH "${table}" Layers)
	if(error OR layerCount EQUAL 0)
		message(FATAL_ERROR "strata_add_layer_libraries: ${ARG_TABLE} has no Layers (${error})")
	endif()

	set(globs "")
	foreach(extension IN ITEMS h hpp inl c cpp m mm)
		list(APPEND globs "${ARG_SOURCE_ROOT}/*.${extension}")
	endforeach()
	file(GLOB_RECURSE sources CONFIGURE_DEPENDS RELATIVE "${ARG_SOURCE_ROOT}" ${globs})
	# Platform implementations of the other operating systems.
	if(WIN32)
		list(FILTER sources EXCLUDE REGEX "^Platform/(Posix|Linux|MacOS)/")
	elseif(APPLE)
		list(FILTER sources EXCLUDE REGEX "^Platform/(Windows|Linux)/")
	else()
		list(FILTER sources EXCLUDE REGEX "^Platform/(Windows|MacOS)/")
	endif()
	list(SORT sources)

	math(EXPR lastLayer "${layerCount} - 1")
	set(layerNames "")
	foreach(index RANGE ${lastLayer})
		string(JSON layer GET "${table}" Layers ${index})
		string(JSON name GET "${layer}" Name)
		list(APPEND layerNames "${name}")
		strata_json_string_array("${layer}" Paths paths)
		strata_json_string_array("${layer}" Exclude excludes)
		strata_json_string_array("${layer}" MayInclude mayInclude)
		set(regexes "")
		foreach(glob IN LISTS paths)
			strata_glob_to_regex("${glob}" regex)
			list(APPEND regexes "${regex}")
		endforeach()
		set(excludeRegexes "")
		foreach(glob IN LISTS excludes)
			strata_glob_to_regex("${glob}" regex)
			list(APPEND excludeRegexes "${regex}")
		endforeach()
		set(layer_${name}_Paths "${regexes}")
		set(layer_${name}_Exclude "${excludeRegexes}")
		set(layer_${name}_MayInclude "${mayInclude}")
		set(layer_${name}_Sources "")
		string(JSON tooling ERROR_VARIABLE error GET "${layer}" Tooling)
		if(error)
			set(tooling OFF)
		endif()
		set(layer_${name}_Tooling ${tooling})
		string(JSON option ERROR_VARIABLE error GET "${layer}" Option)
		if(error)
			set(option "")
		endif()
		set(layer_${name}_Option "${option}")
	endforeach()

	# Every file in exactly one layer: the rule Architecture.Layering enforces.
	foreach(source IN LISTS sources)
		set(owners "")
		foreach(name IN LISTS layerNames)
			set(matched OFF)
			foreach(regex IN LISTS layer_${name}_Paths)
				if(source MATCHES "${regex}")
					set(matched ON)
					break()
				endif()
			endforeach()
			if(matched)
				foreach(regex IN LISTS layer_${name}_Exclude)
					if(source MATCHES "${regex}")
						set(matched OFF)
						break()
					endif()
				endforeach()
			endif()
			if(matched)
				list(APPEND owners "${name}")
			endif()
		endforeach()
		list(LENGTH owners ownerCount)
		if(ownerCount EQUAL 0)
			message(FATAL_ERROR "The engine source '${source}' is in no layer of ${ARG_TABLE}: give its folder or file a pattern")
		elseif(ownerCount GREATER 1)
			string(REPLACE ";" ", " ownerList "${owners}")
			message(FATAL_ERROR "The engine source '${source}' is in several layers of ${ARG_TABLE} (${ownerList}): exclude it from all but one")
		endif()
		list(APPEND layer_${owners}_Sources "${source}")
	endforeach()

	set(builtLayers "")
	set(runtimeLayers "")
	set(toolingLayers "")
	set(json "{\n\t\"Layers\": [")
	set(separator "")
	foreach(name IN LISTS layerNames)
		set(target "Strata_${name}")
		set(built ON)
		if(layer_${name}_Option AND NOT ${layer_${name}_Option})
			set(built OFF)
		endif()

		set(links "")
		foreach(dependency IN LISTS layer_${name}_MayInclude)
			if(dependency IN_LIST builtLayers)
				list(APPEND links "${dependency}")
			endif()
		endforeach()

		if(built)
			list(APPEND builtLayers "${name}")
			if(layer_${name}_Tooling)
				list(APPEND toolingLayers "${name}")
			else()
				list(APPEND runtimeLayers "${name}")
			endif()

			set(absoluteSources "")
			set(compiled OFF)
			foreach(source IN LISTS layer_${name}_Sources)
				list(APPEND absoluteSources "${ARG_SOURCE_ROOT}/${source}")
				if(source MATCHES "\\.(c|cpp|m|mm)$")
					set(compiled ON)
				endif()
			endforeach()

			set(excludeFromAll "")
			if(layer_${name}_Tooling)
				set(excludeFromAll EXCLUDE_FROM_ALL)
			endif()
			if(compiled)
				add_library(${target} STATIC ${excludeFromAll} ${absoluteSources})
				strata_configure_target(${target})
				target_link_libraries(${target} PRIVATE StrataEngineCodegen)
				strata_precompile_headers(${target} "${ARG_SOURCE_ROOT}/stpch.h")
				set(scope PUBLIC)
			else()
				add_library(${target} INTERFACE ${excludeFromAll} ${absoluteSources})
				target_compile_features(${target} INTERFACE cxx_std_20)
				set(scope INTERFACE)
			endif()
			add_library(Strata::${name} ALIAS ${target})
			set_target_properties(${target} PROPERTIES FOLDER "Strata/Layers" STRATA_LAYER "${name}" STRATA_TOOLING ${layer_${name}_Tooling})
			source_group(TREE "${ARG_SOURCE_ROOT}" FILES ${absoluteSources})
			foreach(dependency IN LISTS links)
				target_link_libraries(${target} ${scope} Strata_${dependency})
			endforeach()
		endif()

		set(sourcesJson "")
		set(sourceSeparator "")
		foreach(source IN LISTS layer_${name}_Sources)
			strata_json_quote("${source}" quoted)
			string(APPEND sourcesJson "${sourceSeparator}\n\t\t\t\t${quoted}")
			set(sourceSeparator ",")
		endforeach()
		set(linksJson "")
		set(linkSeparator "")
		foreach(dependency IN LISTS links)
			strata_json_quote("${dependency}" quoted)
			string(APPEND linksJson "${linkSeparator}${quoted}")
			set(linkSeparator ", ")
		endforeach()
		if(built)
			set(builtJson "true")
		else()
			set(builtJson "false")
		endif()
		if(layer_${name}_Tooling)
			set(toolingJson "true")
		else()
			set(toolingJson "false")
		endif()
		strata_json_quote("${name}" quotedName)
		strata_json_quote("${target}" quotedTarget)
		strata_json_quote("${layer_${name}_Option}" quotedOption)
		string(APPEND json "${separator}\n\t\t{\n\t\t\t\"Name\": ${quotedName},\n\t\t\t\"Target\": ${quotedTarget},\n\t\t\t\"Built\": ${builtJson},\n"
			"\t\t\t\"Tooling\": ${toolingJson},\n\t\t\t\"Option\": ${quotedOption},\n\t\t\t\"Links\": [${linksJson}],\n\t\t\t\"Sources\": [${sourcesJson}\n\t\t\t]\n\t\t}")
		set(separator ",")
	endforeach()
	string(APPEND json "\n\t]\n}\n")
	file(CONFIGURE OUTPUT "${ARG_LIBRARIES_FILE}" CONTENT "${json}" @ONLY)

	set(STRATA_BUILT_LAYERS "${builtLayers}" PARENT_SCOPE)
	set(STRATA_RUNTIME_LAYERS "${runtimeLayers}" PARENT_SCOPE)
	set(STRATA_TOOLING_LAYERS "${toolingLayers}" PARENT_SCOPE)
endfunction()

function(strata_layer_link layer scope)
	if(NOT layer IN_LIST STRATA_BUILT_LAYERS)
		return()
	endif()
	get_target_property(type Strata_${layer} TYPE)
	if(type STREQUAL "INTERFACE_LIBRARY" AND NOT scope STREQUAL "INTERFACE")
		message(FATAL_ERROR "strata_layer_link: the ${layer} layer has nothing to compile; link its libraries INTERFACE")
	endif()
	target_link_libraries(Strata_${layer} ${scope} ${ARGN})
endfunction()

# Collects the targets `item` names (an entry of LINK_LIBRARIES or INTERFACE_LINK_LIBRARIES: a target, an ALIAS, a
# generator expression such as $<LINK_ONLY:...> around one) into the global property STRATA_LINK_CLOSURE.
function(strata_collect_link_closure item path)
	# Names, with namespaces ("Strata::Core"); the words of a generator expression ("LINK_ONLY", "CONFIG") name no target.
	string(REGEX MATCHALL "[A-Za-z0-9_.+-]+(::[A-Za-z0-9_.+-]+)?" names "${item}")
	foreach(name IN LISTS names)
		if(NOT TARGET "${name}")
			continue()
		endif()
		get_target_property(aliased "${name}" ALIASED_TARGET)
		if(aliased)
			set(name "${aliased}")
		endif()
		get_property(closure GLOBAL PROPERTY STRATA_LINK_CLOSURE)
		if("${name}" IN_LIST closure)
			continue()
		endif()
		set_property(GLOBAL APPEND PROPERTY STRATA_LINK_CLOSURE "${name}")
		set_property(GLOBAL PROPERTY STRATA_LINK_PATH_${name} "${path} -> ${name}")
		foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
			get_target_property(linked "${name}" ${property})
			if(linked)
				foreach(next IN LISTS linked)
					strata_collect_link_closure("${next}" "${path} -> ${name}")
				endforeach()
			endif()
		endforeach()
	endforeach()
endfunction()

function(strata_check_link_closure target)
	strata_defer_to_end(strata_check_link_closure_now "${target}" ${ARGN})
endfunction()

function(strata_check_link_closure_now target)
	cmake_parse_arguments(ARG "" "" "FORBID" ${ARGN})
	if(NOT TARGET ${target})
		message(FATAL_ERROR "strata_check_link_closure: ${target} is no target")
	endif()
	set_property(GLOBAL PROPERTY STRATA_LINK_CLOSURE "")
	foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
		get_target_property(linked ${target} ${property})
		if(linked)
			foreach(item IN LISTS linked)
				strata_collect_link_closure("${item}" "${target}")
			endforeach()
		endif()
	endforeach()
	get_property(closure GLOBAL PROPERTY STRATA_LINK_CLOSURE)
	set(problems "")
	foreach(name IN LISTS closure)
		get_target_property(tooling ${name} STRATA_TOOLING)
		if("${name}" IN_LIST ARG_FORBID OR tooling)
			get_property(path GLOBAL PROPERTY STRATA_LINK_PATH_${name})
			list(APPEND problems "  ${path}")
		endif()
	endforeach()
	if(problems)
		string(REPLACE ";" "\n" problems "${problems}")
		message(FATAL_ERROR "${target} links tooling that games must not contain:\n${problems}\n"
			"Runtime layers never include tooling layers (Layers.json); a program links tooling only through StrataTooling.")
	endif()
endfunction()
