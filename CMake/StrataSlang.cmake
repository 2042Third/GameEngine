# Slang, the shader compiler the build runs (Docs/DeveloperGuide.md, "Shaders"). It is not a submodule: a pinned release
# archive is fetched once per user and machine into a per-user cache, verified by its SHA-256, and only the files slangc
# loads (and the licenses) are extracted. STRATA_SLANG_ROOT names an extracted release to use instead (offline machines).
#
# strata_find_slang(<outSlangc>) is what the build calls; the other functions are its steps, tested by
# StrataTests/Shaders/SlangFetchTests.cmake (StrataSlang.Fetch). Only functions and constants: nothing runs when this
# file is included, so the test can include it in script mode.

include_guard(GLOBAL)

set(STRATA_SLANG_VERSION "2026.20")
set(STRATA_SLANG_URL "https://github.com/shader-slang/slang/releases/download/v2026.20")
# Release archives of shader-slang/slang v2026.20 (2026-10-17) and their SHA-256 digests. Bump all four together, in a
# commit of its own (Docs/DeveloperGuide.md, "Shaders").
set(STRATA_SLANG_ARCHIVE_WINDOWS_X86_64 "slang-2026.20-windows-x86_64.zip")
set(STRATA_SLANG_SHA256_WINDOWS_X86_64 "e6dd32bbddf1720ebb4e679d55e9635ce792865a5bd84f3d2cd9af28647c0174")
set(STRATA_SLANG_ARCHIVE_LINUX_X86_64 "slang-2026.20-linux-x86_64-glibc-2.27.tar.gz")
set(STRATA_SLANG_SHA256_LINUX_X86_64 "b831477e994dee2fb36a3e83c54ad89cbfeefd47b4d973b2d8bed65b64780996")
set(STRATA_SLANG_ARCHIVE_MACOS_AARCH64 "slang-2026.20-macos-aarch64.tar.gz")
set(STRATA_SLANG_SHA256_MACOS_AARCH64 "07fa8833fdbb343c3674c84fdd885910f495f3daaaa0c732b32980151e8b58c4")
set(STRATA_SLANG_ARCHIVE_MACOS_X86_64 "slang-2026.20-macos-x86_64.tar.gz")
set(STRATA_SLANG_SHA256_MACOS_X86_64 "b4f01f615dc625f60c593d7d0a4bbd38e05dfa2a34bfd3973017c309d866feaa")
# What is extracted (slangc, the libraries it loads and the licenses), relative to the archive's root, and that root's
# folder in the archive. Not extracted: the documentation (its paths are too long for some Windows caches), headers,
# slang-llvm (up to 107 MB), slang-rt, gfx and the standard modules, which plain HLSL never imports. On Linux slangc
# finds libslang-compiler.so.0.2026.20 through its RUNPATH ($ORIGIN/../lib) and loads the two glslang modules by name.
set(STRATA_SLANG_FILES_WINDOWS_X86_64 bin/slangc.exe bin/slang.dll bin/slang-compiler.dll bin/slang-glslang.dll
	bin/slang-glsl-module.dll LICENSE LICENSES third-party-notices)
set(STRATA_SLANG_ROOT_IN_ARCHIVE_WINDOWS_X86_64 "")
set(STRATA_SLANG_FILES_LINUX_X86_64 bin/slangc lib/libslang-compiler.so.0.2026.20 lib/libslang-glslang-2026.20.so
	lib/libslang-glsl-module-2026.20.so LICENSE LICENSES third-party-notices)
set(STRATA_SLANG_ROOT_IN_ARCHIVE_LINUX_X86_64 "")
set(STRATA_SLANG_FILES_MACOS_AARCH64 bin/slangc lib/libslang-compiler.0.2026.20.dylib lib/libslang-glslang-2026.20.dylib
	lib/libslang-glsl-module-2026.20.dylib LICENSE LICENSES third-party-notices)
set(STRATA_SLANG_ROOT_IN_ARCHIVE_MACOS_AARCH64 "")
set(STRATA_SLANG_FILES_MACOS_X86_64 ${STRATA_SLANG_FILES_MACOS_AARCH64})
set(STRATA_SLANG_ROOT_IN_ARCHIVE_MACOS_X86_64 "")

# The key of the pinned archive for the machine CMake runs on (WINDOWS_X86_64, LINUX_X86_64, MACOS_AARCH64 or
# MACOS_X86_64), empty when none is pinned. Uses only what is set in script mode too.
function(strata_slang_host_key out)
	cmake_host_system_information(RESULT platform QUERY OS_PLATFORM)
	string(TOUPPER "${platform}" processor)
	set(key "")
	if(CMAKE_HOST_WIN32)
		if(processor STREQUAL "AMD64" OR processor STREQUAL "X86_64")
			set(key "WINDOWS_X86_64")
		endif()
	elseif(CMAKE_HOST_APPLE)
		if(processor STREQUAL "ARM64" OR processor STREQUAL "AARCH64")
			set(key "MACOS_AARCH64")
		elseif(processor STREQUAL "X86_64")
			set(key "MACOS_X86_64")
		endif()
	elseif(CMAKE_HOST_LINUX)
		if(processor STREQUAL "X86_64" OR processor STREQUAL "AMD64")
			set(key "LINUX_X86_64")
		endif()
	endif()
	set(${out} "${key}" PARENT_SCOPE)
endfunction()

# The per-user folder that holds the fetched toolchains, following the engine's per-user directories: Windows
# %LOCALAPPDATA%/Strata/Toolchains, macOS ~/Library/Caches/Strata/Toolchains, Linux $XDG_CACHE_HOME/strata/toolchains
# when that is absolute, else ~/.cache/strata/toolchains. Empty when the variable it needs is unset. SYSTEM (Windows,
# Darwin or Linux; tests only) picks the branch instead of the host.
function(strata_slang_cache_directory out)
	cmake_parse_arguments(PARSE_ARGV 1 ARG "" "SYSTEM" "")
	set(system "${ARG_SYSTEM}")
	if(system STREQUAL "")
		if(CMAKE_HOST_WIN32)
			set(system "Windows")
		elseif(CMAKE_HOST_APPLE)
			set(system "Darwin")
		else()
			set(system "Linux")
		endif()
	endif()
	set(directory "")
	if(system STREQUAL "Windows")
		if(NOT "$ENV{LOCALAPPDATA}" STREQUAL "")
			file(TO_CMAKE_PATH "$ENV{LOCALAPPDATA}" base)
			set(directory "${base}/Strata/Toolchains")
		endif()
	elseif(system STREQUAL "Darwin")
		if(NOT "$ENV{HOME}" STREQUAL "")
			set(directory "$ENV{HOME}/Library/Caches/Strata/Toolchains")
		endif()
	elseif(system STREQUAL "Linux")
		set(xdg "$ENV{XDG_CACHE_HOME}")
		if(NOT xdg STREQUAL "" AND IS_ABSOLUTE "${xdg}")
			set(directory "${xdg}/strata/toolchains")
		elseif(NOT "$ENV{HOME}" STREQUAL "")
			set(directory "$ENV{HOME}/.cache/strata/toolchains")
		endif()
	else()
		message(FATAL_ERROR "strata_slang_cache_directory: SYSTEM must be Windows, Darwin or Linux, not '${system}'")
	endif()
	set(${out} "${directory}" PARENT_SCOPE)
endfunction()

# slangc's file name on this host.
function(strata_slang_compiler_name out)
	if(CMAKE_HOST_WIN32)
		set(${out} "slangc.exe" PARENT_SCOPE)
	else()
		set(${out} "slangc" PARENT_SCOPE)
	endif()
endfunction()

# Reads the digest stamp of an extraction into <out> (empty when there is none).
function(strata_slang_read_stamp out folder)
	set(stamp "")
	if(EXISTS "${folder}/.strata-slang-sha256")
		file(READ "${folder}/.strata-slang-sha256" stamp)
		string(STRIP "${stamp}" stamp)
		string(TOLOWER "${stamp}" stamp)
	endif()
	set(${out} "${stamp}" PARENT_SCOPE)
endfunction()

# strata_slang_fetch(<outRoot> <outError> URL <url> SHA256 <hex> CACHE_DIR <dir> NAME <folder> FILES <path>...
#                    [ROOT_IN_ARCHIVE <folder>])
# <dir>/<folder> holding a verified extraction of <url>'s FILES, fetched when absent or stamped with another digest.
# Never fails the configure itself: on failure <outRoot> is empty and <outError> the reason. Concurrent configures
# serialize on <dir>/<folder>.lock; the extraction appears by a rename, so no build sees half of one.
function(strata_slang_fetch outRoot outError)
	cmake_parse_arguments(PARSE_ARGV 2 ARG "" "URL;SHA256;CACHE_DIR;NAME;ROOT_IN_ARCHIVE" "FILES")
	foreach(required URL SHA256 CACHE_DIR NAME FILES)
		if("${ARG_${required}}" STREQUAL "")
			message(FATAL_ERROR "strata_slang_fetch: ${required} is required")
		endif()
	endforeach()
	set(${outRoot} "" PARENT_SCOPE)
	set(${outError} "" PARENT_SCOPE)
	string(TOLOWER "${ARG_SHA256}" expected)
	get_filename_component(archive "${ARG_URL}" NAME)
	set(final "${ARG_CACHE_DIR}/${ARG_NAME}")
	strata_slang_compiler_name(compiler)

	# A complete extraction of this digest: no lock, no network.
	strata_slang_read_stamp(stamp "${final}")
	if(stamp STREQUAL expected)
		set(${outRoot} "${final}" PARENT_SCOPE)
		return()
	endif()

	if(NOT IS_DIRECTORY "${ARG_CACHE_DIR}")
		file(MAKE_DIRECTORY "${ARG_CACHE_DIR}")
		# The cache holds programs the build runs, so only its user may change it.
		if(NOT CMAKE_HOST_WIN32)
			file(CHMOD "${ARG_CACHE_DIR}" DIRECTORY_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
		endif()
	endif()
	set(lock "${ARG_CACHE_DIR}/${ARG_NAME}.lock")
	file(LOCK "${lock}" GUARD FUNCTION TIMEOUT 900 RESULT_VARIABLE lockResult)
	if(NOT lockResult EQUAL 0)
		set(${outError} "Another configure has held ${lock} for 15 minutes. If none runs, delete the file and configure again." PARENT_SCOPE)
		return()
	endif()

	# Another configure may have finished the extraction while this one waited for the lock.
	strata_slang_read_stamp(stamp "${final}")
	if(stamp STREQUAL expected)
		set(${outRoot} "${final}" PARENT_SCOPE)
		return()
	endif()

	set(part "${final}.part")
	set(staging "${final}.staging")
	file(REMOVE "${part}")
	set(downloaded FALSE)
	set(statusMessage "")
	foreach(attempt RANGE 1 3)
		if(attempt EQUAL 1)
			message(STATUS "Downloading ${archive} into ${ARG_CACHE_DIR}")
		else()
			message(STATUS "Downloading ${archive} again (attempt ${attempt} of 3)")
			execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
		endif()
		file(DOWNLOAD "${ARG_URL}" "${part}" STATUS status INACTIVITY_TIMEOUT 60 TIMEOUT 1200 TLS_VERIFY ON)
		list(GET status 0 statusCode)
		list(LENGTH status statusLength)
		if(statusLength GREATER 1)
			list(GET status 1 statusMessage)
		endif()
		if(statusCode EQUAL 0)
			set(downloaded TRUE)
			break()
		endif()
	endforeach()
	if(NOT downloaded)
		file(REMOVE "${part}")
		set(${outError} "Strata compiles its shaders with Slang ${STRATA_SLANG_VERSION} and could not download it from ${ARG_URL}: ${statusMessage}. Connect to the network and configure again, or download ${archive} on another machine, check that its SHA-256 is ${expected}, extract it and configure with -DSTRATA_SLANG_ROOT=<the extracted folder> (or set the environment variable STRATA_SLANG_ROOT)." PARENT_SCOPE)
		return()
	endif()

	file(SHA256 "${part}" actual)
	string(TOLOWER "${actual}" actual)
	if(NOT actual STREQUAL expected)
		file(REMOVE "${part}")
		set(${outError} "The download of ${ARG_URL} has SHA-256 ${actual}, not the pinned ${expected}: it was not used. Configure again to download it again; if it keeps differing, the release was replaced: report it, do not change the digest to match." PARENT_SCOPE)
		return()
	endif()

	file(REMOVE_RECURSE "${final}" "${staging}")
	file(MAKE_DIRECTORY "${staging}")
	set(patterns "")
	foreach(path IN LISTS ARG_FILES)
		if(ARG_ROOT_IN_ARCHIVE)
			list(APPEND patterns "${ARG_ROOT_IN_ARCHIVE}/${path}")
		else()
			list(APPEND patterns "${path}")
		endif()
	endforeach()
	# Extracted by a child CMake: an archive that lacks a listed path is an error of that process, which this one reports
	# instead of failing the configure (file(ARCHIVE_EXTRACT) would).
	execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${part}" -- ${patterns}
		WORKING_DIRECTORY "${staging}" RESULT_VARIABLE extractResult OUTPUT_VARIABLE extractOutput ERROR_VARIABLE extractOutput)
	string(STRIP "${extractOutput}" extractOutput)
	set(root "${staging}")
	if(ARG_ROOT_IN_ARCHIVE)
		set(root "${staging}/${ARG_ROOT_IN_ARCHIVE}")
	endif()
	if(NOT EXISTS "${root}/bin/${compiler}")
		file(REMOVE_RECURSE "${staging}")
		file(REMOVE "${part}")
		set(${outError} "${archive} holds no bin/${compiler} (${extractOutput})" PARENT_SCOPE)
		return()
	endif()
	if(NOT extractResult EQUAL 0)
		file(REMOVE_RECURSE "${staging}")
		file(REMOVE "${part}")
		set(${outError} "${archive} could not be extracted into ${staging}: ${extractOutput}" PARENT_SCOPE)
		return()
	endif()

	file(WRITE "${root}/.strata-slang-sha256" "${expected}\n")
	file(RENAME "${root}" "${final}" RESULT renameResult)
	if(ARG_ROOT_IN_ARCHIVE)
		file(REMOVE_RECURSE "${staging}")
	endif()
	file(REMOVE "${part}")
	if(NOT renameResult EQUAL 0)
		file(REMOVE_RECURSE "${staging}")
		set(${outError} "Could not move the extraction of ${archive} to ${final}: ${renameResult}" PARENT_SCOPE)
		return()
	endif()
	set(${outRoot} "${final}" PARENT_SCOPE)
endfunction()

# Empty <outError> when <root>/bin/slangc exists, runs and prints the pinned version for -v; else the reason.
function(strata_slang_check outError root)
	strata_slang_compiler_name(compiler)
	set(slangc "${root}/bin/${compiler}")
	if(NOT EXISTS "${slangc}")
		set(${outError} "${root} holds no bin/${compiler}" PARENT_SCOPE)
		return()
	endif()
	execute_process(COMMAND "${slangc}" -v RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output TIMEOUT 60)
	string(STRIP "${output}" output)
	if(NOT result EQUAL 0)
		set(${outError} "${slangc} did not run (${result}): ${output}" PARENT_SCOPE)
		return()
	endif()
	string(REPLACE "." "\\." versionPattern "${STRATA_SLANG_VERSION}")
	if(NOT output MATCHES "^v?${versionPattern}$")
		set(${outError} "${root} is Slang ${output}; Strata's shaders are pinned to ${STRATA_SLANG_VERSION} (CMake/StrataSlang.cmake)" PARENT_SCOPE)
		return()
	endif()
	set(${outError} "" PARENT_SCOPE)
endfunction()

# The path of the slangc the build runs: STRATA_SLANG_ROOT's when set, else the pin for this host from the per-user
# cache, fetched when missing. Stops the configure with what to do when neither works.
function(strata_find_slang outSlangc)
	set(STRATA_SLANG_ROOT "$ENV{STRATA_SLANG_ROOT}" CACHE PATH
		"An extracted Slang ${STRATA_SLANG_VERSION} release to use instead of the pinned download")
	strata_slang_compiler_name(compiler)
	if(NOT STRATA_SLANG_ROOT STREQUAL "")
		file(TO_CMAKE_PATH "${STRATA_SLANG_ROOT}" root)
		strata_slang_check(error "${root}")
		if(NOT error STREQUAL "")
			message(FATAL_ERROR "STRATA_SLANG_ROOT: ${error}. Configure with -DSTRATA_SLANG_ROOT=<an extracted Slang ${STRATA_SLANG_VERSION} release>, or without it to use the pinned download.")
		endif()
		set(how "STRATA_SLANG_ROOT")
	else()
		strata_slang_host_key(key)
		if(key STREQUAL "")
			cmake_host_system_information(RESULT processor QUERY OS_PLATFORM)
			message(FATAL_ERROR "No Slang ${STRATA_SLANG_VERSION} archive is pinned for ${CMAKE_HOST_SYSTEM_NAME} ${processor}: download the release for this machine from ${STRATA_SLANG_URL}, extract it and configure with -DSTRATA_SLANG_ROOT=<folder>.")
		endif()
		strata_slang_cache_directory(cacheDirectory)
		if(cacheDirectory STREQUAL "")
			if(CMAKE_HOST_WIN32)
				set(variable "LOCALAPPDATA")
			else()
				set(variable "HOME")
			endif()
			message(FATAL_ERROR "${variable} is not set, so Strata has no per-user cache for Slang: set it, or configure with -DSTRATA_SLANG_ROOT=<folder>.")
		endif()
		string(TOLOWER "slang-${STRATA_SLANG_VERSION}-${key}" name)
		strata_slang_read_stamp(stamp "${cacheDirectory}/${name}")
		string(TOLOWER "${STRATA_SLANG_SHA256_${key}}" digest)
		if(stamp STREQUAL digest)
			set(how "cached")
		else()
			set(how "downloaded")
		endif()
		set(rootInArchive "")
		if(STRATA_SLANG_ROOT_IN_ARCHIVE_${key})
			set(rootInArchive ROOT_IN_ARCHIVE "${STRATA_SLANG_ROOT_IN_ARCHIVE_${key}}")
		endif()
		strata_slang_fetch(root error
			URL "${STRATA_SLANG_URL}/${STRATA_SLANG_ARCHIVE_${key}}"
			SHA256 "${digest}"
			CACHE_DIR "${cacheDirectory}"
			NAME "${name}"
			FILES ${STRATA_SLANG_FILES_${key}}
			${rootInArchive})
		if(NOT error STREQUAL "")
			message(FATAL_ERROR "${error}")
		endif()
		strata_slang_check(error "${root}")
		if(NOT error STREQUAL "")
			message(FATAL_ERROR "The pinned Slang (${root}) did not run on this machine: ${error}. Configure with -DSTRATA_SLANG_ROOT=<a Slang ${STRATA_SLANG_VERSION} build that runs here>.")
		endif()
	endif()
	message(STATUS "Slang ${STRATA_SLANG_VERSION}: ${root}/bin/${compiler} (${how})")
	set(${outSlangc} "${root}/bin/${compiler}" PARENT_SCOPE)
endfunction()
