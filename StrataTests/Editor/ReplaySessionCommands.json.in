[
	{ "command": "editor.activity", "parameters": { "limit": 1 }, "bind": { "start": "/journal/latest" } },
	{ "command": "material.create", "parameters": { "path": "Materials/Crate.stmat", "properties": { "BaseColor": [0.7, 0.45, 0.2, 1], "Roughness": 0.6 } },
		"bind": { "crateMaterial": "/asset" } },
	{ "command": "entity.find", "parameters": { "name": "Sun" }, "bind": { "sun": "/entities/0" } },
	{ "command": "component.set", "parameters": { "entity": { "$ref": "sun" }, "component": "DirectionalLight", "values": { "Intensity": 3 } } },
	{ "command": "entity.create", "parameters": { "name": "Crates" }, "bind": { "group": "/id" } },
	{ "command": "entity.create", "parameters": { "name": "Crate", "parent": { "$ref": "group" }, "components": {
		"MeshRenderer": { "Mesh": "Builtin/Cube", "Material": { "$ref": "crateMaterial" } }, "Transform": { "Translation": [0, 0.5, 0] } } },
		"bind": { "crate": "/id" } },
	{ "command": "component.add", "parameters": { "entity": { "$ref": "crate" }, "component": "RigidBody", "values": { "Mass": 3 } } },
	{ "command": "component.add", "parameters": { "entity": { "$ref": "crate" }, "component": "BoxCollider" } },
	{ "command": "prefab.create", "parameters": { "entities": [ { "$ref": "crate" } ], "path": "Prefabs/Crate.stprefab" }, "bind": { "prefab": "/asset" } },
	{ "command": "prefab.instantiate", "parameters": { "prefab": { "$ref": "prefab" }, "parent": { "$ref": "group" },
		"components": { "Transform": { "Translation": [1.5, 0.5, 0] } } } },
	{ "command": "entity.duplicate", "parameters": { "entities": [ { "$ref": "crate" } ] }, "bind": { "copy": "" } },
	{ "command": "component.set", "parameters": { "entity": { "$ref": "copy", "pointer": "/id" }, "component": "Transform",
		"values": { "Translation": [-1.5, 0.5, 0], "Rotation": [0, 30, 0] } } },
	{ "command": "entity.rename", "parameters": { "entity": { "$ref": "copy", "pointer": "/entities/0" }, "name": "Crate Left" } },
	{ "command": "entity.create", "parameters": { "name": "Lamp", "components": { "PointLight": { "Intensity": 12, "Range": 6 },
		"Transform": { "Translation": [0, 3, 0] } } }, "bind": { "lamp": "/id" } },
	{ "command": "entity.setParent", "parameters": { "entities": [ { "$ref": "lamp" } ], "parent": { "$ref": "group" }, "index": 0 } },
	{ "command": "entity.create", "parameters": { "name": "Scratch" }, "bind": { "scratch": "/id" } },
	{ "command": "entity.delete", "parameters": { "entities": [ { "$ref": "scratch" } ] } },
	{ "command": "edit.undo" },
	{ "command": "edit.redo" },
	{ "command": "material.set", "parameters": { "material": { "$ref": "crateMaterial" }, "properties": { "Metallic": 0.3 } } },
	{ "command": "scene.setSettings", "parameters": { "gravity": [0, -12, 0] } },
	{ "command": "play.start" },
	{ "command": "entity.create", "parameters": { "name": "Only While Playing" } },
	{ "command": "editor.wait", "parameters": { "frames": 3 } },
	{ "command": "play.stop" },
	{ "command": "scene.save" },
	{ "command": "editor.activity.export", "parameters": { "path": "@REPLAY_SESSION_JSON@", "since": { "$ref": "start" } },
		"expect": { "/edits": { "equals": 20 }, "/lookups": { "equals": 1 }, "/skippedWhilePlaying": { "equals": 1 } } }
]
