[
	{ "command": "editor.commands" },
	{ "command": "entity.create", "parameters": { "name": "Floor", "components": { "MeshRenderer": { "Mesh": "0000000000000003" }, "Transform": { "Scale": [10, 1, 10] } } } },
	{ "command": "entity.create", "parameters": { "name": "Sun", "components": { "DirectionalLight": { "Intensity": 3 } } } },
	{ "command": "entity.create", "parameters": { "name": "Lamp", "components": { "PointLight": { "Intensity": 5, "Range": 8 } } } },
	{ "command": "entity.create", "parameters": { "name": "Crate", "components": { "MeshRenderer": { "Mesh": "Builtin/Cube" }, "Transform": { "Translation": [0, 0.5, 0] } } } },
	{ "command": "entity.create", "parameters": { "name": "Camera", "components": { "Camera": {}, "Transform": { "Translation": [0, 2, 6] } } } },
	{ "command": "camera.focus" },
	{ "command": "camera.set", "parameters": { "yaw": 30, "pitch": -25 } },
	{ "command": "camera.get" },
	{ "command": "editor.wait", "parameters": { "frames": 2 } },
	{ "command": "viewport.capture", "parameters": { "width": 960, "height": 540, "path": "@STRATA_SMOKE_CAPTURE_DIR@/SmokeViewport.png", "overwrite": true } },
	{ "command": "viewport.capture", "parameters": { "width": 320, "height": 180, "camera": "scene", "path": "@STRATA_SMOKE_CAPTURE_DIR@/SmokeSceneCamera.png", "overwrite": true } },
	{ "command": "scene.setSettings", "parameters": { "gravity": [0, -9.81, 0] } },
	{ "command": "edit.undo" },
	{ "command": "edit.redo" },
	{ "command": "play.start" },
	{ "command": "editor.wait", "parameters": { "frames": 2 } },
	{ "command": "viewport.capture", "parameters": { "width": 160, "height": 90 } },
	{ "command": "play.pause", "parameters": { "paused": true } },
	{ "command": "play.step", "parameters": { "frames": 2 } },
	{ "command": "play.stop" },
	{ "command": "scene.hierarchy" },
	{ "command": "log.read", "parameters": { "minLevel": "Warn" } }
]
