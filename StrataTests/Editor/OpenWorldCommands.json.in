[
	{"command": "script.build", "expect": {"/success": {"equals": true}}},
	{"command": "editor.status", "parameters": {"sections": ["assets"]}, "expect": {"/assets/importing": {"equals": 0}, "/assets/scanning": {"equals": null}}, "until": {"seconds": 900}},
	{"command": "component.get", "parameters": {"entity": "F7486ABFA648EBD7", "component": "PostProcess"}, "expect": {"/values/AntiAliasingMethod": {"equals": "TAA"}}},
	{"command": "component.get", "parameters": {"entity": "63B6A780439CC809", "component": "HeightFog"}, "expect": {"/values/Density": {"min": 0.001, "max": 0.002}, "/values/StartDistance": {"min": 39.9, "max": 40.1}, "/values/ColorFromSky": {"equals": true}}},
	{"command": "entity.find", "parameters": {"name": "Player"}, "bind": {"player": "/entities/0"}},
	{"command": "entity.find", "parameters": {"name": "Sun"}, "bind": {"sun": "/entities/0"}},
	{"command": "world.info", "parameters": {"world": "Worlds/Island.stworld"}, "expect": {"/layers/0/name": {"equals": "Vegetation"}, "/layers/0/cells": {"min": 80}, "/layers/1/name": {"equals": "Wildlife"}, "/layers/2/name": {"equals": "Landmarks"}, "/index/cooked": {"equals": true}, "/index/maxBodiesInRadius": {"min": 5000}, "/index/persistentBodies": {"max": 110}}},
	{"command": "script.setField", "parameters": {"entity": {"$ref": "player"}, "class": "Explorer", "field": "TourOnStart", "value": false}},
	{"command": "play.start", "expect": {"/state": {"equals": "Play"}}},
	{"command": "play.pause", "parameters": {"paused": true}},
	{"command": "world.status", "expect": {"/playing/loaded": {"min": 9}, "/playing/loading": {"equals": 0}}, "until": {"seconds": 300}},
	{"command": "physics.stats", "expect": {"/waitingForMeshes": {"equals": false}, "/pendingOther": {"equals": 0}}, "until": {"seconds": 300}},
	{"command": "input.key", "parameters": {"key": "Tab"}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "player"}, "class": "Explorer"}, "expect": {"/scripts/0/fields/Walking": {"equals": true}, "/scripts/0/fields/Grounded": {"equals": true}}, "until": {"steps": 300}},
	{"command": "script.setField", "parameters": {"entity": {"$ref": "player"}, "class": "Explorer", "field": "DistanceWalked", "value": 0}},
	{"command": "input.key", "parameters": {"key": "W", "steps": 120}},
	{"command": "play.step", "parameters": {"steps": 125}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "player"}, "class": "Explorer"}, "expect": {"/scripts/0/fields/DistanceWalked": {"min": 4}, "/scripts/0/fields/HeightAboveGround": {"min": -0.1}}},
	{"command": "input.key", "parameters": {"key": "D3"}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "player"}, "class": "Explorer"}, "expect": {"/scripts/0/fields/TeleportsDone": {"equals": 1}, "/scripts/0/fields/Grounded": {"equals": true}}, "until": {"seconds": 300}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "player"}, "class": "Explorer"}, "expect": {"/scripts/0/fields/StartAreaLoaded": {"equals": false}, "/scripts/0/fields/HeightAboveGround": {"min": -0.1}}},
	{"command": "entity.find", "parameters": {"name": "Eye"}, "bind": {"eye": "/entities/0"}},
	{"command": "component.set", "parameters": {"entity": {"$ref": "eye"}, "component": "Transform", "values": {"Translation": [0, 1.6, 4000]}}},
	{"command": "play.step", "parameters": {"steps": 10}},
	{"command": "world.status", "expect": {"/playing/wanted": {"min": 9}}},
	{"command": "component.set", "parameters": {"entity": {"$ref": "eye"}, "component": "Transform", "values": {"Translation": [0, 1.6, 0]}}},
	{"command": "entity.find", "parameters": {"component": "Animator", "box": {"min": [16, -50, -280], "max": [96, 200, -200]}}, "bind": {"fox": "/entities/0"}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "fox"}, "class": "Wander"}, "expect": {"/scripts/0/fields/StateIndex": {"min": 0, "max": 2}}},
	{"command": "script.setField", "parameters": {"entity": {"$ref": "fox"}, "class": "Wander", "field": "Distance", "value": 0}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "fox"}, "class": "Wander"}, "expect": {"/scripts/0/fields/Distance": {"min": 1}}, "until": {"steps": 1200}},
	{"command": "entity.find", "parameters": {"tag": "Campfire", "box": {"min": [16, -50, -280], "max": [96, 200, -200]}}, "bind": {"fire": "/entities/0"}},
	{"command": "script.setField", "parameters": {"entity": {"$ref": "sun"}, "class": "DayNight", "field": "DayLengthSeconds", "value": 20}},
	{"command": "component.get", "parameters": {"entity": {"$ref": "fire"}, "component": "PointLight"}, "expect": {"/values/Intensity": {"min": 0.1}}, "until": {"steps": 900}},
	{"command": "play.stop", "expect": {"/state": {"equals": "Edit"}}},
	{"command": "edit.undo"},
	{"command": "scene.info", "expect": {"/modified": {"equals": false}}},
	{"command": "project.export", "parameters": {"directory": "@EXPORT_DIR_JSON@"}, "expect": {"/excludedAssets": {"equals": []}}},
	{"command": "project.export", "parameters": {"directory": "@PRUNED_EXPORT_DIR_JSON@", "prune": true}, "expect": {"/assetCount": {"min": 1}}}
]
