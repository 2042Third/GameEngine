[
	{"command": "script.build", "expect": {"/success": {"equals": true}}},
	{"command": "editor.status", "parameters": {"sections": ["assets"]}, "expect": {"/assets/importing": {"equals": 0}, "/assets/scanning": {"equals": null}}, "until": {"seconds": 900}},
	{"command": "scene.info", "expect": {"/name": {"equals": "MainMenu"}}},
	{"command": "entity.find", "parameters": {"name": "Game"}, "bind": {"menu": "/entities/0"}},
	{"command": "script.setField", "parameters": {"entity": {"$ref": "menu"}, "class": "MainMenu", "field": "AttractDelaySeconds", "value": 0}},
	{"command": "play.start", "expect": {"/state": {"equals": "Play"}}},
	{"command": "entity.find", "parameters": {"name": "Play"}, "bind": {"playButton": "/entities/0"}},
	{"command": "input.click", "parameters": {"entity": {"$ref": "playButton"}}},
	{"command": "play.state", "expect": {"/running/name": {"equals": "Course"}}, "until": {"seconds": 60}},
	{"command": "play.pause", "parameters": {"paused": true}},
	{"command": "physics.stats", "expect": {"/waitingForMeshes": {"equals": false}, "/pendingOther": {"equals": 0}}, "until": {"seconds": 300}},
	{"command": "entity.find", "parameters": {"name": "Player"}, "bind": {"player": "/entities/0"}},
	{"command": "entity.find", "parameters": {"name": "Crate"}, "bind": {"crate": "/entities/0"}},
	{"command": "entity.find", "parameters": {"name": "Game"}, "bind": {"game": "/entities/0"}},
	{"command": "entity.find", "parameters": {"name": "CoinsText"}, "bind": {"coinsText": "/entities/0"}},
	{"command": "entity.find", "parameters": {"name": "SettingsOpen"}, "bind": {"settingsButton": "/entities/0"}},
	{"command": "entity.find", "parameters": {"name": "InvertYToggle"}, "bind": {"invertY": "/entities/0"}},
	{"command": "entity.find", "parameters": {"name": "Resume"}, "bind": {"resume": "/entities/0"}},
	{"command": "entity.find", "parameters": {"name": "Complete"}, "bind": {"completePanel": "/entities/0"}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "player"}, "class": "ThirdPersonPlayer"}, "expect": {"/scripts/0/fields/Grounded": {"equals": true}, "/scripts/0/fields/AnimatorState": {"equals": 0}}, "until": {"steps": 300}},
	{"command": "script.setField", "parameters": {"entity": {"$ref": "player"}, "class": "ThirdPersonPlayer", "field": "DistanceWalkedForward", "value": 0}},
	{"command": "input.key", "parameters": {"key": "W", "steps": 90}},
	{"command": "play.step", "parameters": {"steps": 45}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "player"}, "class": "ThirdPersonPlayer"}, "expect": {"/scripts/0/fields/AnimatorState": {"min": 1, "max": 2}}},
	{"command": "play.step", "parameters": {"steps": 50}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "player"}, "class": "ThirdPersonPlayer"}, "expect": {"/scripts/0/fields/DistanceWalkedForward": {"min": 3}}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "player"}, "class": "ThirdPersonPlayer"}, "expect": {"/scripts/0/fields/AnimatorState": {"equals": 0}}, "until": {"steps": 60}},
	{"command": "entity.find", "parameters": {"name": "Camera"}, "bind": {"camera": "/entities/0"}},
	{"command": "component.set", "parameters": {"entity": {"$ref": "player"}, "component": "Transform", "values": {"Translation": [0, 0.02, 3]}}},
	{"command": "play.step", "parameters": {"steps": 5}},
	{"command": "script.setField", "parameters": {"entity": {"$ref": "player"}, "class": "ThirdPersonPlayer", "field": "DistanceWalkedForward", "value": 0}},
	{"command": "input.gamepadAxis", "parameters": {"axis": "LeftY", "value": 1, "steps": 90}},
	{"command": "play.step", "parameters": {"steps": 95}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "player"}, "class": "ThirdPersonPlayer"}, "expect": {"/scripts/0/fields/DistanceWalkedForward": {"min": 3}}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "player"}, "class": "ThirdPersonPlayer"}, "expect": {"/scripts/0/fields/AnimatorState": {"equals": 0}}, "until": {"steps": 60}},
	{"command": "script.setField", "parameters": {"entity": {"$ref": "camera"}, "class": "FollowCamera", "field": "Pitch", "value": -18}},
	{"command": "input.gamepadAxis", "parameters": {"axis": "RightY", "value": 1, "steps": 30}},
	{"command": "play.step", "parameters": {"steps": 32}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "camera"}, "class": "FollowCamera"}, "expect": {"/scripts/0/fields/Pitch": {"min": 0}}},
	{"command": "script.setField", "parameters": {"entity": {"$ref": "camera"}, "class": "FollowCamera", "field": "Pitch", "value": -18}},
	{"command": "input.key", "parameters": {"key": "Space"}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "player"}, "class": "ThirdPersonPlayer"}, "expect": {"/scripts/0/fields/MaxJumpHeight": {"min": 0.5}}, "until": {"steps": 60}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "player"}, "class": "ThirdPersonPlayer"}, "expect": {"/scripts/0/fields/Grounded": {"equals": true}}, "until": {"steps": 120}},
	{"command": "component.set", "parameters": {"entity": {"$ref": "player"}, "component": "Transform", "values": {"Translation": [0, 1.06, -28.5]}}},
	{"command": "play.step", "parameters": {"steps": 30}},
	{"command": "input.key", "parameters": {"key": "W", "steps": 120}},
	{"command": "play.step", "parameters": {"steps": 125}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "crate"}, "class": "Pushable"}, "expect": {"/scripts/0/fields/Displacement": {"min": 0.5}}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "game"}, "class": "CourseState"}, "expect": {"/scripts/0/fields/Coins": {"equals": 0}}},
	{"command": "component.set", "parameters": {"entity": {"$ref": "player"}, "component": "Transform", "values": {"Translation": [-2.5, 1.06, -29.5]}}},
	{"command": "component.get", "parameters": {"entity": {"$ref": "coinsText"}, "component": "UIText"}, "expect": {"/values/Text": {"equals": "1 / 12"}}, "until": {"steps": 120}},
	{"command": "input.key", "parameters": {"key": "Escape"}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "game"}, "class": "PauseMenu"}, "expect": {"/scripts/0/fields/Paused": {"equals": true}, "/scripts/0/fields/TimeScale": {"equals": 0}}, "until": {"steps": 10}},
	{"command": "input.click", "parameters": {"entity": {"$ref": "settingsButton"}}},
	{"command": "entity.get", "parameters": {"entity": {"$ref": "invertY"}}, "expect": {"/active": {"equals": true}}, "until": {"steps": 10}},
	{"command": "play.step", "parameters": {"steps": 2}},
	{"command": "input.click", "parameters": {"entity": {"$ref": "invertY"}}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "game"}, "class": "SettingsMenu"}, "expect": {"/scripts/0/fields/Saves": {"equals": 1}}, "until": {"steps": 10}},
	{"command": "input.click", "parameters": {"entity": {"$ref": "resume"}}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "game"}, "class": "PauseMenu"}, "expect": {"/scripts/0/fields/Paused": {"equals": false}, "/scripts/0/fields/TimeScale": {"equals": 1}}, "until": {"steps": 10}},
	{"command": "component.set", "parameters": {"entity": {"$ref": "player"}, "component": "Transform", "values": {"Translation": [0, 11.06, -71.5]}}},
	{"command": "script.get", "parameters": {"entity": {"$ref": "game"}, "class": "CourseState"}, "expect": {"/scripts/0/fields/Completed": {"equals": true}}, "until": {"steps": 60}},
	{"command": "entity.get", "parameters": {"entity": {"$ref": "completePanel"}}, "expect": {"/active": {"equals": true}}},
	{"command": "play.stop", "expect": {"/state": {"equals": "Edit"}}},
	{"command": "edit.undo"},
	{"command": "scene.info", "expect": {"/modified": {"equals": false}}},
	{"command": "project.export", "parameters": {"directory": "@EXPORT_DIR_JSON@"}, "expect": {"/excludedAssets": {"equals": []}}},
	{"command": "project.export", "parameters": {"directory": "@PRUNED_EXPORT_DIR_JSON@", "prune": true}, "expect": {"/assetCount": {"min": 1}}}
]
