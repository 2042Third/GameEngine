[
	{ "command": "scene.open", "parameters": { "scene": "Scenes/Feature.stscene" } },
	{ "command": "editor.showPanel", "parameters": { "panel": "Inspector" } },
	{ "command": "editor.screenshot", "parameters": { "path": "@STRATA_FEATURE_CAPTURE_DIR@/Window.png" },
		"expect": { "/width": { "equals": 1280 }, "/height": { "equals": 720 }, "/panel": { "equals": null }, "/settled": { "equals": true } } },
	{ "command": "editor.screenshot", "parameters": { "panel": "Inspector", "path": "@STRATA_FEATURE_CAPTURE_DIR@/Inspector.png" },
		"expect": { "/panel": { "equals": "Inspector" }, "/width": { "min": 100, "max": 1279 }, "/height": { "min": 100, "max": 719 }, "/settled": { "equals": true } } },
	{ "command": "viewport.capture", "parameters": { "camera": "scene", "width": 320, "height": 180, "path": "@STRATA_FEATURE_CAPTURE_DIR@/Scene.png" },
		"expect": { "/complete": { "equals": true }, "/screenSpaceReflectionsPending": { "equals": false } } },
	{ "command": "viewport.capture", "parameters": { "camera": "scene", "width": 320, "height": 180, "path": "@STRATA_FEATURE_CAPTURE_DIR@/Switched.png",
		"renderer": { "FadeLevelsOfDetail": true, "GPUDriven": false, "BatchAcrossMaterials": false, "TextureStreaming": false, "SpecularAntiAliasing": false,
			"VisibilityFeedback": false, "OcclusionCulling": false, "DitherOutput": false, "SpecularEnergyCompensation": false, "HorizonFade": false,
			"SpatialReflectionResolve": false, "GlobalIlluminationBounceGain": 0, "FXAASubpixel": 0.75 } },
		"expect": { "/complete": { "equals": true }, "/renderer/SpecularEnergyCompensation": { "equals": false }, "/renderer/FXAASubpixel": { "equals": 0.75 } } },
	{ "command": "viewport.capture", "parameters": { "camera": "scene", "width": 320, "height": 180 },
		"expect": { "/complete": { "equals": true }, "/renderer": { "equals": {} } } },
	{ "command": "viewport.capture", "parameters": { "camera": "scene", "width": 320, "height": 180, "debugView": "specular",
		"path": "@STRATA_FEATURE_CAPTURE_DIR@/Specular.png" }, "expect": { "/complete": { "equals": true }, "/debugView/view": { "equals": "specular" } } },
	{ "command": "viewport.capture", "parameters": { "camera": "scene", "width": 320, "height": 180, "debugView": "diffuse",
		"path": "@STRATA_FEATURE_CAPTURE_DIR@/Diffuse.png" }, "expect": { "/complete": { "equals": true }, "/debugView/view": { "equals": "diffuse" } } },
	{ "command": "viewport.capture", "parameters": { "camera": "scene", "width": 320, "height": 180, "debugView": "clusters",
		"path": "@STRATA_FEATURE_CAPTURE_DIR@/Clusters.png" }, "expect": { "/complete": { "equals": true }, "/debugView/view": { "equals": "clusters" } } },
	{ "command": "viewport.capture", "parameters": { "camera": "scene", "width": 320, "height": 180, "debugView": "culled",
		"path": "@STRATA_FEATURE_CAPTURE_DIR@/Culled.png" }, "expect": { "/complete": { "equals": true }, "/debugView/view": { "equals": "culled" } } },
	{ "command": "viewport.capture", "parameters": { "camera": "scene", "width": 320, "height": 180, "debugView": "wireframe",
		"path": "@STRATA_FEATURE_CAPTURE_DIR@/Wireframe.png" }, "expect": { "/complete": { "equals": true }, "/debugView/view": { "equals": "wireframe" } } }
]
