[
	{ "command": "scene.open", "parameters": { "scene": "Scenes/Feature.stscene" } },
	{ "command": "editor.showPanel", "parameters": { "panel": "Inspector" } },
	{ "command": "editor.screenshot", "parameters": { "path": "@STRATA_FEATURE_CAPTURE_DIR@/Window.png" },
		"expect": { "/width": { "equals": 1280 }, "/height": { "equals": 720 }, "/panel": { "equals": null } } },
	{ "command": "editor.screenshot", "parameters": { "panel": "Inspector", "path": "@STRATA_FEATURE_CAPTURE_DIR@/Inspector.png" },
		"expect": { "/panel": { "equals": "Inspector" }, "/width": { "min": 100, "max": 1279 }, "/height": { "min": 100, "max": 719 } } },
	{ "command": "viewport.capture", "parameters": { "camera": "scene", "width": 320, "height": 180, "path": "@STRATA_FEATURE_CAPTURE_DIR@/Scene.png" },
		"expect": { "/complete": { "equals": true }, "/screenSpaceReflectionsPending": { "equals": false } } }
]
