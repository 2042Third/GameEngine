[
	{ "command": "entity.find", "parameters": { "name": "Game" }, "bind": { "game": "/entities/0" } },
	{ "command": "entity.find", "parameters": { "name": "StartDominoes" }, "bind": { "start": "/entities/0" } },
	{ "command": "entity.find", "parameters": { "name": "FeedGoal" }, "bind": { "feed": "/entities/0" } },
	{ "command": "play.start", "expect": { "/state": { "equals": "Play" }, "/built/build": { "min": 1 } } },
	{ "command": "play.pause", "parameters": { "paused": true } },
	{ "command": "script.setField", "parameters": { "entity": { "$ref": "game" }, "class": "Playground", "field": "AutoDemo", "value": false } },
	{ "command": "physics.stats", "expect": { "/bodies/dynamic": { "min": 600 } } },
	{ "command": "script.get", "parameters": { "entity": { "$ref": "game" }, "class": "Playground" }, "expect": { "/scripts/0/fields/Bodies": { "equals": 615 } } },
	{ "command": "play.step", "parameters": { "steps": 180 } },
	{ "command": "script.get", "parameters": { "entity": { "$ref": "game" }, "class": "Playground" },
		"expect": { "/scripts/0/fields/TowerTopDrift": { "max": 0.25 }, "/scripts/0/fields/BallsEscaped": { "equals": 0 } } },
	{ "command": "script.get", "parameters": { "entity": { "$ref": "game" }, "class": "Playground" },
		"expect": { "/scripts/0/fields/GhostsOnPitFloor": { "equals": 8 } }, "until": { "steps": 600, "seconds": 600 } },
	{ "command": "input.click", "parameters": { "entity": { "$ref": "start" } } },
	{ "command": "script.get", "parameters": { "entity": { "$ref": "game" }, "class": "Playground" },
		"expect": { "/scripts/0/fields/DominoesDown": { "min": 60 } }, "until": { "steps": 1200, "seconds": 900 } },
	{ "command": "input.click", "parameters": { "entity": { "$ref": "feed" } } },
	{ "command": "script.get", "parameters": { "entity": { "$ref": "game" }, "class": "Playground" },
		"expect": { "/scripts/0/fields/Score": { "min": 4 } }, "until": { "steps": 900, "seconds": 900 } },
	{ "command": "input.mouseMove", "parameters": { "position": [ 640, 360 ] } },
	{ "command": "input.mouseButton", "parameters": { "button": "Left" } },
	{ "command": "play.step", "parameters": { "steps": 3 } },
	{ "command": "script.get", "parameters": { "entity": { "$ref": "game" }, "class": "Playground" },
		"expect": { "/scripts/0/fields/Shots": { "equals": 1 }, "/scripts/0/fields/LastShotForwardSpeed": { "min": 12 } } },
	{ "command": "script.reload", "expect": { "/loadCount": { "min": 2 } } },
	{ "command": "play.step", "parameters": { "steps": 1 } },
	{ "command": "script.get", "parameters": { "entity": { "$ref": "game" }, "class": "Playground" },
		"expect": { "/scripts/0/fields/Reloads": { "equals": 1 }, "/scripts/0/fields/Shots": { "equals": 1 }, "/scripts/0/fields/Bodies": { "equals": 621 } } },
	{ "command": "input.key", "parameters": { "key": "R" } },
	{ "command": "play.step", "parameters": { "steps": 60 } },
	{ "command": "script.get", "parameters": { "entity": { "$ref": "game" }, "class": "Playground" },
		"expect": { "/scripts/0/fields/Bodies": { "equals": 615 }, "/scripts/0/fields/DominoesDown": { "equals": 0 }, "/scripts/0/fields/Shots": { "equals": 0 },
			"/scripts/0/fields/TowerTopDrift": { "max": 0.25 } } },
	{ "command": "script.setField", "parameters": { "entity": { "$ref": "game" }, "class": "Playground", "field": "AutoDemo", "value": false } },
	{ "command": "input.click", "parameters": { "entity": { "$ref": "start" } } },
	{ "command": "script.get", "parameters": { "entity": { "$ref": "game" }, "class": "Playground" },
		"expect": { "/scripts/0/fields/DominoesDown": { "min": 60 } }, "until": { "steps": 1200, "seconds": 900 } },
	{ "command": "play.stop", "expect": { "/state": { "equals": "Edit" } } },
	{ "command": "scene.info", "expect": { "/modified": { "equals": false } } },
	{ "command": "project.export", "parameters": { "directory": "@EXPORT_DIR_JSON@" }, "expect": { "/excludedAssets": { "equals": [] } } },
	{ "command": "project.export", "parameters": { "directory": "@PRUNED_EXPORT_DIR_JSON@", "prune": true }, "expect": { "/assetCount": { "min": 1 } } }
]
